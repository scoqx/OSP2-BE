# Игнорировать всё в корне (и файлы, и папки)
/*

# Но оставить эти директории индексируемыми
!/code/
!/build/
!/.cursor/
!/assets/
!.cursorignore

# В assets видеть только два конфига, подпапки и остальное — игнор
assets/*
!/assets/OSP2.cfg
!/assets/OSP2English.cfg

# При этом внутри build по‑прежнему игнорировать тяжёлые артефакты
